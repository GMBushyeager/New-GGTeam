MONGODB_URI=
MONGODB_DB=

# Anthropic API is reached through the GYMGUYZ prompt service, not directly.
PROMPT_SERVICE_URL=
PROMPT_SERVICE_KEY=

# Expo / EAS
EXPO_PUBLIC_API_URL=
